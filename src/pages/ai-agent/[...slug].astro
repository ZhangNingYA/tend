---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ModulePost from '../../layouts/ModulePost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('aiAgent');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'aiAgent'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ModulePost title={entry.data.title} description={entry.data.description} pubDate={entry.data.pubDate} tags={entry.data.tags} module="ai-agent" moduleLabel="AI Agent"><Content /></ModulePost>
