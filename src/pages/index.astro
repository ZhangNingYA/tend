---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import '../styles/studio.css';

const notes = (await getCollection('fieldNotes')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const builds = (await getCollection('builds')).filter((build) => !build.data.draft);
const featured = notes.find((note) => note.data.featured) ?? notes[0];
const latest = notes.slice(0, 3);
const typeLabels = { note: '笔记', reading: '阅读', tutorial: '教程', experiment: '实验' };
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description="一个公开记录 AI Agent 学习、实验与构建过程的个人实验室。" /></head>
  <body class="studio-page">
    <BlogHeader />
    <main class="studio-shell studio-main">
      <section class="studio-dashboard-head">
        <div class="studio-dashboard-copy">
          <div class="studio-kicker"><span class="studio-kicker-dot"></span> AI Agent 研究记录 / 工作台</div>
          <h1>AI Agent<br /><em>实验工作台。</em></h1>
          <p>用笔记、实验和项目，把 Agent 的检索、记忆、工具调用与评测过程拆开来看。</p>
          <div class="studio-dashboard-actions"><a class="studio-button studio-button-primary" href="/field-notes/">打开学习笔记 ↗</a><a class="studio-button studio-button-ghost" href="/now/">查看当前方向</a></div>
        </div>
        <div class="studio-hero-art studio-agent-scene" data-agent-scene aria-label="AI Agent 三维系统可视化">
          <div class="agent-scene-grid"></div>
          <div class="agent-scene-glow"></div>
          <span class="agent-spark agent-spark-one">+</span><span class="agent-spark agent-spark-two">✦</span><span class="agent-spark agent-spark-three">·</span>
          <div class="agent-orbit agent-orbit-outer"><span class="agent-orbit-dot"></span></div>
          <div class="agent-orbit agent-orbit-middle"><span class="agent-orbit-dot"></span></div>
          <div class="agent-orbit agent-orbit-inner"><span class="agent-orbit-dot"></span></div>
          <div class="agent-connection agent-connection-one"></div><div class="agent-connection agent-connection-two"></div><div class="agent-connection agent-connection-three"></div>
          <div class="agent-core"><div class="agent-core-face"><i></i><i></i><b>✦</b></div><strong>AGENT</strong><small>CORE SYSTEM</small></div>
          <div class="agent-node agent-node-rag"><span>↗</span><strong>RAG</strong><small>检索</small></div>
          <div class="agent-node agent-node-memory"><span>◌</span><strong>MEMORY</strong><small>记忆</small></div>
          <div class="agent-node agent-node-tools"><span>⌘</span><strong>TOOLS</strong><small>调用</small></div>
          <div class="agent-floating-chip agent-chip-input">INPUT <b>问题</b></div>
          <div class="agent-floating-chip agent-chip-output">OUTPUT <b>答案</b></div>
          <div class="agent-scene-caption"><span>LIVE LAB / 01</span><strong>observe → decide → act</strong></div>
        </div>
      </section>

      <section class="studio-metric-grid" aria-label="站点概览">
        <div class="studio-metric"><span>学习笔记</span><strong>{String(notes.length).padStart(2, '0')}</strong><small>持续更新</small></div>
        <div class="studio-metric"><span>实验主题</span><strong>03</strong><small>进行中</small></div>
        <div class="studio-metric"><span>已做项目</span><strong>{String(builds.length).padStart(2, '0')}</strong><small>公开展示</small></div>
        <div class="studio-metric"><span>当前方向</span><strong class="studio-metric-text">Agent 系统</strong><small>观察 · 评测 · 迭代</small></div>
      </section>

      {latest.length > 0 && <section class="studio-workspace-grid">
        <div class="studio-workspace-main">
          {featured && <a class="studio-feature-row" href={`/field-notes/${featured.id}/`}><div class="studio-feature-row-meta"><span class="studio-section-label">精选笔记</span><span class="studio-tag">{typeLabels[featured.data.type]}</span>{featured.data.tags.map((tag) => <span class="studio-tag">#{tag}</span>)}</div><h2>{featured.data.title} <span>↗</span></h2><p>{featured.data.description}</p></a>}
          <div class="studio-section-heading"><div><div class="studio-section-label">最新记录</div><h2>最近的笔记</h2></div><a class="studio-inline-link" href="/field-notes/">查看全部 ↗</a></div>
          <div class="studio-note-list">{latest.map((note) => <a class="studio-note-row" href={`/field-notes/${note.id}/`}><span class="studio-note-row-type">{typeLabels[note.data.type]}</span><span class="studio-note-row-copy"><strong>{note.data.title}</strong><small>{note.data.description}</small></span><FormattedDate date={note.data.pubDate} /><span class="studio-note-row-arrow">↗</span></a>)}</div>
        </div>
        <aside class="studio-status-panel" aria-label="当前状态"><div class="studio-card-label">当前状态</div><h2>Agent 系统</h2><p>公开记录观察、决策、调用和结果，让每个判断都能回到证据。</p><ul class="studio-status-list"><li><span>下一步</span><strong>Tool call trace</strong></li><li><span>工作循环</span><strong>观察 → 验证</strong></li><li><span>更新频率</span><strong>按问题推进</strong></li></ul><a class="studio-inline-link" href="/now/">查看现在 ↗</a></aside>
      </section>}

      <section class="studio-section studio-routes" aria-labelledby="portals-title"><div class="studio-section-heading"><div><div class="studio-section-label">工作区</div><h2 id="portals-title">按任务浏览。</h2></div><p>笔记、实验和项目各自保持清晰的上下文。</p></div><div class="studio-portal-grid"><a class="studio-portal" href="/field-notes/"><div class="studio-portal-top"><span class="studio-portal-index">01 / 笔记</span><span class="studio-portal-arrow">↗</span></div><div><h3>学习笔记</h3><p>概念、阅读和正在形成的判断。</p></div></a><a class="studio-portal" href="/experiments/"><div class="studio-portal-top"><span class="studio-portal-index">02 / 实验</span><span class="studio-portal-arrow">↗</span></div><div><h3>实验记录</h3><p>把问题变成可以操作和观察的实验。</p></div></a><a class="studio-portal" href="/builds/"><div class="studio-portal-top"><span class="studio-portal-index">03 / 项目</span><span class="studio-portal-arrow">↗</span></div><div><h3>已做项目</h3><p>已经运行、测量和交付的系统。</p></div></a></div></section>
    </main>
    <footer class="studio-shell studio-footer"><span>Tend / AI Agent 学习记录</span><span><a href="/now/">现在</a> · <a href="/about/">关于</a> · <a href="/games/">个人档案</a></span></footer>
    <script>
      const scene = document.querySelector<HTMLElement>('[data-agent-scene]');
      if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.addEventListener('pointermove', (event) => {
          const x = (event.clientX / window.innerWidth - 0.5) * 2;
          const y = (event.clientY / window.innerHeight - 0.5) * 2;
          scene.style.setProperty('--scene-tilt-x', `${y * -3}deg`);
          scene.style.setProperty('--scene-tilt-y', `${x * 4}deg`);
        }, { passive: true });
      }
    </script>
  </body>
</html>
