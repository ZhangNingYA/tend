---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import ModuleHeader from '../../components/ModuleHeader.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/site.css';

const entries = (await getCollection('projects')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const statusLabels = { incubating: 'incubating', building: 'building', shipped: 'shipped' };
const dateLabel = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`Projects · ${SITE_TITLE}`} description="正在构建和已经交付的项目展示。" /></head>
  <body class="site-page module-page module-projects">
    <ModuleHeader active="projects" />
    <main class="module-frame">
      <header class="module-hero"><p class="module-kicker">Projects / showcase</p><div class="module-hero-count"><strong>{String(entries.length).padStart(2, '0')}</strong> builds</div></header>
      <section aria-label="Project entries">{entries.length > 0 ? <div class="module-list">{entries.map((entry) => <a class="module-entry" href={`/projects/${entry.id}/`}><div><div class="module-entry-meta"><span class="module-entry-type">{statusLabels[entry.data.status]}</span><span>{dateLabel(entry.data.pubDate)}</span></div><p class="module-entry-title">{entry.data.title}</p><p>{entry.data.description}</p></div><div class="module-entry-footer"><span class="module-tags">{entry.data.stack.map((item) => <span class="module-tag">{item}</span>)}</span><span>↗</span></div></a>)}</div> : <div class="module-empty"><strong>第一个项目的位置已经留好。</strong><span>下一个值得运行的想法会从这里开始。</span></div>}</section>
    </main>
    <footer class="module-footer"><span>Projects / Tend</span><a href="/">回到首页 ↗</a></footer>
  </body>
</html>
