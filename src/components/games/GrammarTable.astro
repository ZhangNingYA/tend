---
type Cell = string | { label: string; code?: string };
type Props = {
  headers: string[];
  rows: Cell[][];
};
const { headers, rows } = Astro.props;
---
<div class="grammar-table-wrap">
  <table>
    <thead><tr>{headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell) => (
            <td>
              {typeof cell === 'string' ? cell : (
                <><span>{cell.label}</span>{cell.code && <code>{cell.code}</code>}</>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
