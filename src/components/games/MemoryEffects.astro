<dialog class="memory-lightbox" aria-label="照片大图">
  <button type="button" class="memory-lightbox-close" aria-label="关闭照片">×</button>
  <img alt="" /><p></p>
</dialog>
<script>
  const lightbox = document.querySelector<HTMLDialogElement>('.memory-lightbox');
  if (lightbox) {
    const image = lightbox.querySelector('img')!;
    const caption = lightbox.querySelector('p')!;
    const close = () => lightbox.close();
    document.querySelectorAll<HTMLButtonElement>('[data-memory-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        image.src = button.dataset.memoryPhoto!;
        image.alt = button.querySelector('img')?.alt || '';
        caption.textContent = button.dataset.photoCaption || '';
        lightbox.showModal();
        document.documentElement.classList.add('memory-modal-open');
      });
    });
    lightbox.querySelector('button')?.addEventListener('click', close);
    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) close(); });
    lightbox.addEventListener('close', () => document.documentElement.classList.remove('memory-modal-open'));
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('book-revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('[data-book-reveal]').forEach((element) => observer.observe(element));
  }

  const isKept = (id: string) => {
    try { return localStorage.getItem(`tend-keepsake-${id}`) === 'yes' || Boolean(JSON.parse(localStorage.getItem(`tend-memory-${id}`) || 'null')?.kept); }
    catch { return false; }
  };
  const refreshStamps = () => {
    document.querySelectorAll<HTMLElement>('[data-keepsake]').forEach((element) => {
      const kept = isKept(element.dataset.keepsake!);
      element.classList.toggle('is-kept', kept);
      const button = element.querySelector<HTMLButtonElement>('[data-stamp-button]');
      if (button) {
        button.setAttribute('aria-pressed', String(kept));
        button.textContent = kept ? '已经好好收下了 ✓' : '盖上我们的纪念章 ↙';
      }
      const status = element.querySelector('[data-stamp-status]');
      if (status) status.textContent = kept ? '这一页，已经替我们收好了。' : '留下一枚印记，下次回来还在这里。';
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-stamp-button]').forEach((button) => {
    button.addEventListener('click', () => {
      const parent = button.closest<HTMLElement>('[data-keepsake]')!;
      const id = parent.dataset.keepsake!;
      try {
        localStorage.setItem(`tend-keepsake-${id}`, isKept(id) ? 'no' : 'yes');
        // Retire the old flag so an unstamp is respected after migration.
        const legacy = JSON.parse(localStorage.getItem(`tend-memory-${id}`) || 'null');
        if (legacy?.kept) localStorage.setItem(`tend-memory-${id}`, JSON.stringify({ ...legacy, kept: false }));
        refreshStamps();
      } catch {
        const status = parent.querySelector('[data-stamp-status]');
        if (status) status.textContent = '这一刻已经记住啦；当前浏览器无法保存印记。';
      }
    });
  });
  refreshStamps();
  window.addEventListener('pageshow', refreshStamps);
  window.addEventListener('storage', refreshStamps);

  const days = [...document.querySelectorAll<HTMLElement>('[data-diary-day]')];
  const dayLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-day-link]')];
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (days.length) {
    let queued = false;
    let lastId = '';
    const updateReading = () => {
      queued = false;
      const active = days.findLast((day) => day.getBoundingClientRect().top <= 170) || days[0];
      if (lastId !== active.id) {
        lastId = active.id;
        dayLinks.forEach((link) => {
          const current = link.hash === `#${active.id}`;
          if (current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
      if (progress) {
        const first = days[0].offsetTop;
        const last = days.at(-1)!;
        const distance = last.offsetTop + last.offsetHeight - first - window.innerHeight;
        const value = distance > 0 ? Math.max(0, Math.min(1, (window.scrollY - first) / distance)) : 1;
        progress.style.transform = `scaleX(${value})`;
      }
    };
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(updateReading); }
    }, { passive: true });
    window.addEventListener('resize', updateReading);
    updateReading();
  }
</script>
