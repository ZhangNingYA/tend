---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BuildPost from '../../layouts/BuildPost.astro';

export async function getStaticPaths() {
  const builds = (await getCollection('builds')).filter((build) => !build.data.draft);
  return builds.map((build) => ({ params: { slug: build.id }, props: build }));
}

type Props = CollectionEntry<'builds'>;
const build = Astro.props;
const { Content, headings } = await render(build);
---

<BuildPost {...build.data} headings={headings}><Content /></BuildPost>
