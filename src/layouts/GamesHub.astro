---
import { ArrowUpRight, BookOpenText, Search } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import '../styles/games-library.css';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;

const getPaperMeta = (id: string) => {
  const match = id.match(/^(\d{4})-(\d{2})-cet4-reading-(\d+)$/);
  if (!match) return { year: 0, month: 0, set: 0, level: 'CET-4' };

  const [, year, month, set] = match;
  return { year: Number(year), month: Number(month), set: Number(set), level: 'CET-4' };
};

const papers = (await getCollection('games'))
  .filter((post) => post.data.pageLayout === 'reading')
  .map((post) => ({ post, meta: getPaperMeta(post.id) }))
  .sort((a, b) => (
    b.meta.year - a.meta.year
    || b.meta.month - a.meta.month
    || a.meta.set - b.meta.set
  ));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="CET Reading · 四级阅读" description={description} />
  </head>
  <body class="games-hub-page" id="top">
    <a class="skip-link" href="#library">跳转到阅读题库</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/games/" aria-label="CET Reading 首页">
          <span class="brand-mark" aria-hidden="true"><BookOpenText size={21} stroke-width={1.7} /></span>
          <span class="brand-name">CET<span>READING</span></span>
        </a>
      </div>
    </header>

    <main>
      <section class="library-section container" id="library" aria-labelledby="library-title">
        <div class="section-heading">
          <h1 id="library-title">阅读题库</h1>
        </div>

        <div class="library-toolbar">
          <label class="paper-search">
            <Search size={16} stroke-width={1.6} aria-hidden="true" />
            <span class="sr-only">搜索文章标题或年份</span>
            <input id="paper-search" type="search" placeholder="搜索标题或年份" autocomplete="off" />
          </label>
        </div>

        <div class="library-content">
          <div class="library-results" id="library-results">
            <div class="library-status">
              <p id="status">选择一篇文章，开始阅读。</p>
              <span class="result-count" id="paper-count">共 {papers.length} 篇</span>
            </div>

            <div class="paper-grid" id="papers">
              {papers.map(({ post, meta }) => (
                <a
                  class="paper-card"
                  href={`/games/${post.id}/`}
                  data-paper-search={`${post.data.title} ${meta.year} ${meta.month} ${meta.set}`}
                >
                  <div class="paper-card-top">
                    <span class="paper-level">四级 <small>{meta.level}</small></span>
                    <ArrowUpRight class="paper-arrow" size={18} stroke-width={1.6} aria-hidden="true" />
                  </div>
                  <h2>{post.data.title.replace(/\s*·\s*CET-4 Set \d+$/i, '')}</h2>
                  <div class="paper-card-bottom">
                    <span>{meta.year} · {String(meta.month).padStart(2, '0')} · 第 {meta.set} 套</span>
                    <span class="paper-type">阅读练习</span>
                  </div>
                </a>
              ))}
            </div>
            <p class="empty-state" id="empty-state" hidden>暂时没有匹配的文章。</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-brand">CET READING</p>
          <p>把每一句，读成自己的积累。</p>
        </div>
        <div class="footer-right">
          <span>专注英语四级阅读</span>
          <a href="#top">回到顶部 <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>

    <script>
      const search = document.querySelector<HTMLInputElement>('#paper-search');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-paper-search]'));
      const count = document.querySelector<HTMLElement>('#paper-count');
      const empty = document.querySelector<HTMLElement>('#empty-state');
      const status = document.querySelector<HTMLElement>('#status');

      const filterPapers = () => {
        const query = search?.value.trim().toLowerCase() ?? '';
        let visible = 0;
        cards.forEach((card) => {
          const matches = !query || card.dataset.paperSearch?.toLowerCase().includes(query);
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        if (count) count.textContent = `共 ${visible} 篇`;
        if (empty) empty.hidden = visible > 0;
        if (status) status.textContent = query ? `找到 ${visible} 篇文章。` : '选择一篇文章，开始阅读。';
      };

      search?.addEventListener('input', filterPapers);
    </script>
  </body>
</html>
