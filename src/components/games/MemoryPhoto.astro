---
import type { MemoryPhoto } from '../../data/travelDiary';
interface Props { photo: MemoryPhoto; class?: string; eager?: boolean; caption?: boolean }
const { photo, class: className = '', eager = false, caption = true } = Astro.props;
const src = `/images/memories/${photo.name}.webp`;
---
<figure class:list={['memory-photo', className]}>
  <button class="memory-photo-open" type="button" data-memory-photo={src} data-photo-caption={photo.caption} aria-label={`放大照片：${photo.alt}`}>
    <img src={src} srcset={`/images/memories/${photo.name}-small.webp 640w, ${src} ${photo.width}w`} sizes="(max-width: 700px) 100vw, 800px" width={photo.width} height={photo.height} alt={photo.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
    <span class="memory-photo-expand" aria-hidden="true">↗</span>
  </button>
  {caption && <figcaption><span>{photo.caption}</span>{photo.source && <small>地点回望 · <a href={photo.source} target="_blank" rel="noopener noreferrer">{photo.author}</a> / <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.license}</a> · 已缩放压缩</small>}</figcaption>}
</figure>
