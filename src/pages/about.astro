---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/studio.css';

const principles = [
  ['Make the loop visible', 'Agent 的每一步都应该能被观察：输入、决策、工具调用和结果。'],
  ['Prefer evidence to vibes', '实验保留参数和失败结果，文章说明判断如何形成。'],
  ['Ship small systems', '从一个可以测量的小问题开始，再决定是否值得扩展。'],
];
const stack = ['Astro', 'React', 'TypeScript', 'Python', 'LLM APIs', 'RAG'];
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`About · ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
  <body class="studio-page">
    <BlogHeader active="about" theme="dark" />
    <main class="studio-shell studio-main">
      <header class="studio-index-hero"><div><div class="studio-kicker"><span class="studio-kicker-dot"></span> About the lab</div><h1>Small systems.<br />Clear signals.</h1><p>我是一个正在学习 AI Agent Engineering 的独立开发者。Tend 用来记录我如何理解问题、验证假设，并把有用的东西做出来。</p></div><div class="studio-index-count"><strong>∞</strong> learning in public</div></header>
      <section class="studio-section"><div class="studio-section-heading"><div><div class="studio-section-label">Working principles</div><h2>How I work.</h2></div><p>保持好奇，也让过程足够诚实。</p></div><div class="studio-note-grid">{principles.map(([title, body], index) => <article class="studio-note-card"><div class="studio-card-label">0{index + 1}</div><h3>{title}</h3><p>{body}</p></article>)}</div></section>
      <section class="studio-section"><div class="studio-section-heading"><div><div class="studio-section-label">Working stack</div><h2>Tools I reach for.</h2></div></div><div class="studio-filter-bar">{stack.map((item) => <span class="studio-tag">{item}</span>)}</div></section>
    </main>
    <footer class="studio-shell studio-footer"><span>© {new Date().getFullYear()} Tend</span><span><a href="/">Home</a> · <a href="https://github.com/ZhangNingYA">GitHub ↗</a></span></footer>
  </body>
</html>
