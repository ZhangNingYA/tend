---
import BaseHead from '../components/BaseHead.astro';
import ModuleHeader from '../components/ModuleHeader.astro';
import { SITE_TITLE } from '../consts';
import '../styles/site.css';
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description="Tend：两个持续生长的内容模块，记录 AI Agent 与项目实践。" /></head>
  <body class="site-page home-page">
    <ModuleHeader />
    <main class="home-frame">
      <section class="home-intro" aria-labelledby="home-title">
        <div class="home-intro-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> TEND / PERSONAL WORKSPACE</p>
          <h1 id="home-title">一个持续更新的个人工作台</h1>
          <p class="home-lede">这里有两条工作线：一条用来理解 AI Agent，一条用来展示真正运行过的项目。</p>
        </div>
        <dl class="home-index-note"><div><dt>modules</dt><dd>02</dd></div><div><dt>format</dt><dd>MDX</dd></div><div><dt>updated</dt><dd>2026.11</dd></div></dl>
      </section>

      <section class="home-shelves" aria-labelledby="shelves-title">
        <div class="home-shelves-heading"><p id="shelves-title" class="eyebrow"><span class="eyebrow-line"></span> TWO MODULES</p></div>
        <div class="home-shelf-grid">
          <a class="home-shelf home-shelf-agent" href="/ai-agent/"><div class="shelf-top"><span>01 / SYSTEMS</span><span class="shelf-arrow">↗</span></div><div class="shelf-copy"><p>AI Agent</p><h3>理解系统<br /><em>如何工作。</em></h3><span class="shelf-caption">notes · experiments · patterns</span></div><div class="shelf-footer"><span>浏览模块</span><strong>OPEN / 01</strong></div></a>
          <a class="home-shelf home-shelf-projects" href="/projects/"><div class="shelf-top"><span>02 / SHOWCASE</span><span class="shelf-arrow">↗</span></div><div class="shelf-copy"><p>Projects</p><h3>展示想法<br /><em>如何落地。</em></h3><span class="shelf-caption">builds · decisions · shipped work</span></div><div class="shelf-footer"><span>浏览模块</span><strong>OPEN / 02</strong></div></a>
        </div>
      </section>
    </main>
    <footer class="site-footer"><span>Tend / personal workspace</span><span>AI Agent + Projects</span></footer>
  </body>
</html>
