---
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/studio.css';

const tracks = [
  ['01', 'Agent 工作循环', '观察、决策、工具调用、结果反馈'],
  ['02', '有依据的回答', '让 RAG 的证据链可追溯、可评测'],
  ['03', '可靠的系统', '状态、记忆、评测和部署'],
];
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`现在 · ${SITE_TITLE}`} description="当前正在学习和构建的 AI Agent 方向。" /></head>
  <body class="studio-page">
    <BlogHeader active="now" />
    <main class="studio-shell studio-main">
      <header class="studio-index-hero"><div><div class="studio-kicker"><span class="studio-kicker-dot"></span> 当前方向 / 2026</div><h1>现在<br />在做什么。</h1><p>我正在把 AI Agent 当成一个需要观察、评测和持续照料的系统来学习。</p></div><div class="studio-index-count"><strong>03</strong> 个进行中的主题</div></header>
      <section class="studio-section"><div class="studio-section-heading"><div><div class="studio-section-label">当前工作循环</div><h2>从会调用，到值得信任。</h2></div><p>学习不按课程结束，而按问题被弄清楚推进。</p></div><div class="studio-note-grid">{tracks.map(([number, title, body]) => <article class="studio-note-card"><div class="studio-card-label">{number}</div><h3>{title}</h3><p>{body}</p><div class="studio-note-card-footer"><span>进行中</span><span>↗</span></div></article>)}</div></section>
      <section class="studio-feature-grid"><article class="studio-feature"><div class="studio-card-label">当前技术栈</div><h3>Astro × React × Python</h3><p>用 Astro 记录，用 React 做交互，用 Python 验证 Agent 行为；每一次实验都尽量留下可复现的输入和输出。</p></article><article class="studio-now-card"><div class="studio-card-label">下一步</div><h3>把第一个实验做出来。</h3><p>从 Tool call trace 开始：先让 Agent 的行为可见，再谈更复杂的记忆和规划。</p><a class="studio-button studio-button-ghost" href="/experiments/" style="margin-top: 22px">查看实验队列 ↗</a></article></section>
    </main>
    <footer class="studio-shell studio-footer"><span>现在 / Tend</span><span><a href="/about/">关于</a> · <a href="/games/">个人档案</a></span></footer>
  </body>
</html>
