---
import { getCollection } from 'astro:content';
import { ArrowUpRight, BookOpen, Clock3, LibraryBig } from 'lucide-astro';
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import '../../styles/study.css';

const studies = (await getCollection('study')).sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf(),
);
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const latestStudy = studies[0];
const latestDate = latestStudy ? latestStudy.data.updatedDate ?? latestStudy.data.pubDate : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="Study | Tend" description="保存值得反复阅读的 AI 对话与学习记录。" />
  </head>
  <body class="study-page">
    <BlogHeader active="study" />

    <main class="study-index">
      <section class="study-index-hero" aria-labelledby="study-index-title">
        <div class="study-hero-copy">
          <span class="study-kicker"><BookOpen size={15} stroke-width={1.8} /> TEND / STUDY</span>
          <h1 id="study-index-title">把学到的东西，<em>整理成下一步。</em></h1>
          <p>给有用的对话、学习笔记和实践路线一个安静的落点。下次回来时，从这里继续。</p>
          <div class="study-hero-meta" aria-label="学习记录概览">
            <span><LibraryBig size={15} stroke-width={1.8} /> {studies.length} 条记录</span>
            <span><Clock3 size={15} stroke-width={1.8} /> 按最近更新排列</span>
          </div>
        </div>

        {latestStudy && latestDate ? (
          <a class="study-feature" href={`/study/${latestStudy.id}/`}>
            <span class="study-feature-label">最近更新</span>
            <strong>{latestStudy.data.title}</strong>
            <span class="study-feature-meta">{formatDate(latestDate)} · {latestStudy.data.subject ?? '学习记录'}</span>
            <span class="study-feature-link">打开记录 <ArrowUpRight size={17} stroke-width={1.8} aria-hidden="true" /></span>
          </a>
        ) : (
          <div class="study-feature study-feature-empty">
            <span class="study-feature-label">从这里开始</span>
            <strong>下一条学习记录，会出现在这里。</strong>
          </div>
        )}
      </section>

      <section class="study-index-section" aria-labelledby="study-list-title">
        <div class="study-section-heading">
          <div>
            <span class="study-section-label">Library</span>
            <h2 id="study-list-title">近期记录</h2>
          </div>
          <span class="study-section-count">{studies.length} 条</span>
        </div>

        {studies.length ? (
          <ol class="study-record-list">
            {studies.map((study, index) => (
              <li>
                <a class="study-record" href={`/study/${study.id}/`}>
                  <span class="study-record-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <div class="study-record-body">
                    <div class="study-record-meta">
                      <span>{study.data.subject ?? '学习记录'}</span>
                      <time datetime={(study.data.updatedDate ?? study.data.pubDate).toISOString()}>{formatDate(study.data.updatedDate ?? study.data.pubDate)}</time>
                    </div>
                    <div>
                      <h3>{study.data.title}</h3>
                      <p>{study.data.description}</p>
                    </div>
                  </div>
                  <span class="study-record-arrow" aria-hidden="true"><ArrowUpRight size={20} stroke-width={1.7} /></span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="study-empty">这里还没有记录。新的 AI 对话和学习笔记会从这里开始。</p>
        )}
      </section>
    </main>
  </body>
</html>
