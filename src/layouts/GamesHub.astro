---
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import '../styles/games-library.css';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;

const getPaperMeta = (id: string) => {
  const match = id.match(/^(\d{4})-(\d{2})-cet4-reading-(\d+)$/);
  if (!match) return { year: 0, month: 0, set: 0, session: '其他' };

  const [, year, month, set] = match;
  return {
    year: Number(year),
    month: Number(month),
    set: Number(set),
    session: `${year} 年 ${Number(month)} 月`,
  };
};

const papers = (await getCollection('games'))
  .filter((post) => post.data.pageLayout === 'reading')
  .map((post) => ({ post, meta: getPaperMeta(post.id) }))
  .sort((a, b) => (
    b.meta.year - a.meta.year
    || b.meta.month - a.meta.month
    || a.meta.set - b.meta.set
  ));

const sessionMap = new Map<string, typeof papers>();
papers.forEach((paper) => {
  const group = sessionMap.get(paper.meta.session) ?? [];
  group.push(paper);
  sessionMap.set(paper.meta.session, group);
});
const sessions = Array.from(sessionMap, ([label, entries]) => ({ label, entries }));

const getCoverageLabel = (coverage: 'full' | 'passage-only' | 'none' | undefined) => {
  if (coverage === 'full') return '有答案';
  if (coverage === 'passage-only') return '部分答案';
  return '';
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {title} {description} />
  </head>
  <body class="games-hub-page">
    <a class="skip-link" href="#paper-list">跳到列表</a>

    <header class="library-header">
      <a class="library-brand" href="/games/" aria-label="阅读练习首页">
        <span class="library-brand-mark" aria-hidden="true">阅</span>
        <strong>阅读练习</strong>
      </a>
      <nav aria-label="页面导航">
        <a href="/"><ArrowLeft size={15} aria-hidden="true" />首页</a>
      </nav>
    </header>

    <main class="library-shell">
      <header class="library-intro">
        <span class="eyebrow">四级</span>
        <h1 id="page-title">阅读</h1>
      </header>

      <section class="paper-archive" id="paper-list" aria-labelledby="archive-title">
        <header class="archive-heading">
          <h2 id="archive-title">选择一套</h2>
          <span>{papers.length} 套</span>
        </header>

        <div class="session-list">
          {sessions.map((session) => (
            <section class="session-group" aria-labelledby={`session-${session.entries[0].meta.year}-${session.entries[0].meta.month}`}>
              <header class="session-heading">
                <h3 id={`session-${session.entries[0].meta.year}-${session.entries[0].meta.month}`}>{session.label}</h3>
                <span>{session.entries.length} 套</span>
              </header>

              <div class="paper-grid">
                {session.entries.map(({ post, meta }) => {
                  const coverage = getCoverageLabel(post.data.answerCoverage);
                  return (
                    <a class="paper-card" href={`/games/${post.id}/`} aria-label={`${session.label} 第 ${meta.set} 套`}>
                      <span class="paper-number">{String(meta.set).padStart(2, '0')}</span>
                      <span class="paper-title">第 {meta.set} 套</span>
                      {coverage && <span class="paper-status">{coverage}</span>}
                      <ArrowUpRight class="paper-arrow" size={17} stroke-width={1.7} aria-hidden="true" />
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
