---
import { getCollection } from 'astro:content';
import {
  ArrowLeft,
  ArrowUpRight,
  CheckCircle2,
  Clock3,
  Languages,
  Layers3,
} from 'lucide-astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import BaseHead from '../components/BaseHead.astro';
import '../styles/games-library.css';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;

const getPaperMeta = (id: string) => {
  const match = id.match(/^(\d{4})-(\d{2})-cet4-reading-(\d+)$/);
  if (!match) {
    return { year: 0, month: 0, set: 0, session: '其他真题' };
  }

  const [, year, month, set] = match;
  return {
    year: Number(year),
    month: Number(month),
    set: Number(set),
    session: `${year} 年 ${Number(month)} 月`,
  };
};

const papers = (await getCollection('games'))
  .filter((post) => post.data.pageLayout === 'reading')
  .map((post) => ({ post, meta: getPaperMeta(post.id) }))
  .sort((a, b) => (
    b.meta.year - a.meta.year
    || b.meta.month - a.meta.month
    || a.meta.set - b.meta.set
  ));

const sessionMap = new Map<string, typeof papers>();
papers.forEach((paper) => {
  const group = sessionMap.get(paper.meta.session) ?? [];
  group.push(paper);
  sessionMap.set(paper.meta.session, group);
});
const sessions = Array.from(sessionMap, ([label, entries]) => ({ label, entries }));

const answerEntries = papers.filter(({ post }) => post.data.answerCoverage && post.data.answerCoverage !== 'none');
const structureEntries = papers.filter(({ post }) => post.data.hasStructureModes);

const getCoverageLabel = (coverage: 'full' | 'passage-only' | 'none' | undefined) => {
  if (coverage === 'full') return '完整答案';
  if (coverage === 'passage-only') return '仔细阅读答案';
  return '暂未附答案';
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {title} {description} />
  </head>
  <body class="games-hub-page">
    <a class="skip-link" href="#paper-list">跳到真题列表</a>

    <header class="library-header">
      <a class="library-brand" href="/games/" aria-label="返回 Games">
        <span class="library-brand-mark">T</span>
        <span><strong>四级阅读</strong><small>Tend Study</small></span>
      </a>
      <nav aria-label="页面导航">
        <a href="/games/"><ArrowLeft size={15} aria-hidden="true" />返回 Games</a>
        <a href="/">首页</a>
      </nav>
    </header>

    <main class="library-shell">
      <section class="library-hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">CET-4 · READING ARCHIVE</p>
          <h1 id="page-title">把四级阅读，<br /><em>一篇篇读懂。</em></h1>
          <p class="hero-description">{description}</p>
          <a class="hero-link" href="#paper-list">
            选择一套开始 <ArrowUpRight size={16} aria-hidden="true" />
          </a>
        </div>

        <aside class="study-guide" aria-labelledby="guide-title">
          <p class="eyebrow">A QUIET ROUTINE</p>
          <h2 id="guide-title">一次练习，分三步。</h2>
          <ol>
            <li><span>01</span><div><strong>先限时完成</strong><small>保留真实做题节奏</small></div></li>
            <li><span>02</span><div><strong>再核对答案</strong><small>找到判断失误的位置</small></div></li>
            <li><span>03</span><div><strong>最后逐句精读</strong><small>读懂词义与句子结构</small></div></li>
          </ol>
        </aside>
      </section>

      <dl class="library-summary" aria-label="资料概况">
        <div><dt>{String(papers.length).padStart(2, '0')}</dt><dd>套阅读真题</dd></div>
        <div><dt>{answerEntries.length}</dt><dd>套附答案</dd></div>
        <div><dt>{structureEntries.length}</dt><dd>套含结构双模式</dd></div>
      </dl>

      <section class="paper-archive" id="paper-list" aria-labelledby="archive-title">
        <header class="archive-heading">
          <div>
            <p class="eyebrow">PRACTICE PAPERS</p>
            <h2 id="archive-title">选择一套真题</h2>
          </div>
          <p>从新到旧排列，每套都可计时并逐句精读。</p>
        </header>

        <div class="session-list">
          {sessions.map((session) => (
            <section class="session-group" aria-labelledby={`session-${session.entries[0].meta.year}-${session.entries[0].meta.month}`}>
              <header class="session-heading">
                <h3 id={`session-${session.entries[0].meta.year}-${session.entries[0].meta.month}`}>{session.label}</h3>
                <span>{session.entries.length} 套</span>
              </header>

              <div class="paper-grid">
                {session.entries.map(({ post, meta }) => (
                  <a class="paper-card" href={`/games/${post.id}/`}>
                    <div class="paper-card-top">
                      <span>SET {String(meta.set).padStart(2, '0')}</span>
                      <span class={post.data.answerCoverage && post.data.answerCoverage !== 'none' ? 'coverage' : 'coverage coverage--muted'}>
                        {getCoverageLabel(post.data.answerCoverage)}
                      </span>
                    </div>
                    <h4>第 {meta.set} 套阅读</h4>
                    <p>{post.data.description}</p>
                    <ul class="paper-features" aria-label="练习功能">
                      <li><Clock3 size={14} aria-hidden="true" />计时练习</li>
                      <li><Languages size={14} aria-hidden="true" />逐句精读</li>
                      {post.data.hasStructureModes && <li><Layers3 size={14} aria-hidden="true" />结构双模式</li>}
                      {post.data.answerCoverage === 'full' && <li><CheckCircle2 size={14} aria-hidden="true" />答案核对</li>}
                    </ul>
                    <span class="paper-open">打开练习 <ArrowUpRight size={16} aria-hidden="true" /></span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    </main>

    <footer class="library-footer">
      <span>Tend Study · CET-4 Reading</span>
      <span>{papers.length} papers · {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>
