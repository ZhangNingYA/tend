---
import { BookOpenText } from 'lucide-astro';
import SentenceNote from './SentenceNote.astro';
import ReadingQuestions from './ReadingQuestions.astro';
import ReadingSectionAnswers from './ReadingSectionAnswers.astro';
import ReadingTimer from './ReadingTimer.astro';
import type { CloseReading, InlineGlossary } from '../../types/closeReading';
import type { ReadingQuestion } from '../../types/readingQuestion';

interface Passage {
  title: string;
  sentences: readonly string[];
  questions?: readonly ReadingQuestion[];
  wordBank?: readonly { key: string; word: string }[];
  answerRange?: string;
  answers?: readonly {
    number: number;
    key: string;
    word: string;
    evidence: string;
    analysis: string;
  }[];
}

interface MatchingParagraph {
  label: string;
  sentences: readonly string[];
}

interface Props {
  cloze: Passage;
  matching: {
    title: string;
    paragraphs: readonly MatchingParagraph[];
    questions?: readonly {
      number: number;
      prompt: string;
      answer: string;
      evidence: string;
      analysis: string;
    }[];
  };
  passages: readonly Passage[];
  closeReadings?: Readonly<Record<string, CloseReading>>;
  inlineGlossary?: InlineGlossary;
  experience?: 'blog' | 'game';
  timerVariant?: 'default' | 'focus';
}

const {
  cloze,
  matching,
  passages,
  closeReadings,
  inlineGlossary,
  experience = 'blog',
  timerVariant = 'default',
} = Astro.props;
const countWords = (sentences: readonly string[]) => sentences.join(' ').match(
  /[A-Za-z]+(?:['’][A-Za-z]+)?/g,
)?.length ?? 0;
const noteNumber = (prefix: string, index: number) =>
  `${prefix}${String(index + 1).padStart(2, '0')}`;
const sharedGlossaryPhrases = inlineGlossary
  ? [
      ...(inlineGlossary.phrases ?? []),
      ...Object.values(closeReadings ?? {})
        .flatMap((item) => item.vocabulary)
        .filter((item) => (
          item.term.match(/(?<![A-Za-z0-9])[A-Za-z]+(?:['’][A-Za-z]+)?(?![A-Za-z0-9])/g)?.length ?? 0
        ) > 1),
    ]
  : [];
const hasStructureModes = Object.values(closeReadings ?? {}).some((item) => (
  Boolean(item.trunk?.length)
  && item.highlights.some((highlight) => highlight.label?.includes('从句'))
));
---

{(timerVariant === 'focus' || (experience === 'game' && hasStructureModes)) && (
  <section class="reading-guide" aria-label="精读使用说明">
    <div class="reading-guide-heading">
      <span class="reading-guide-kicker">How to read</span>
      <strong>本页使用说明</strong>
    </div>
    <p>先独立通读英文，再按需要展开提示：点击句末的书本图标查看翻译、重点词汇和句子结构；点击英文词或短语查看本句释义。计时器只记录首次通读用时，不是官方考试限时。</p>
    <div class="reading-guide-items" aria-label="精读操作提示">
      <span><i class="guide-icon guide-book" aria-hidden="true"><BookOpenText size={12} stroke-width={1.8} /></i>书本图标：展开精读</span>
      <span><i class="guide-icon guide-word" aria-hidden="true">Aa</i>英文词语：点击查看释义</span>
      <span><i class="guide-icon guide-clock" aria-hidden="true">◷</i>计时器：记录首读</span>
    </div>
    {experience === 'game' && hasStructureModes && (
      <div class="reading-structure-mode" data-structure-mode-control>
        <span class="reading-structure-mode-label">句子成分</span>
        <div class="reading-structure-mode-options" role="group" aria-label="句子成分标记模式">
          <button type="button" data-structure-mode-option="main" aria-pressed="true">仅标记主句</button>
          <button type="button" data-structure-mode-option="all" aria-pressed="false">主句＋从句</button>
        </div>
        <span class="reading-structure-mode-hint">打开书本后，可切换原句颜色和结构分解的范围。</span>
      </div>
    )}
  </section>
)}

{experience === 'game' && hasStructureModes && (
  <script>
    const modeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-structure-mode-option]'),
    );
    const modeStorageKey = 'reading-structure-mode';
    const setStructureMode = (mode: 'main' | 'all') => {
      document.body.dataset.structureMode = mode;
      modeButtons.forEach((button) => {
        const active = button.dataset.structureModeOption === mode;
        button.setAttribute('aria-pressed', String(active));
      });
      try {
        localStorage.setItem(modeStorageKey, mode);
      } catch {
        // Storage can be unavailable in private browsing; the toggle still works.
      }
    };

    let initialMode: 'main' | 'all' = 'main';
    try {
      initialMode = localStorage.getItem(modeStorageKey) === 'all' ? 'all' : 'main';
    } catch {
      // Keep the default main-clause view.
    }
    setStructureMode(initialMode);
    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.structureModeOption === 'all' ? 'all' : 'main';
        setStructureMode(mode);
      });
    });
  </script>
)}

<h2 id="word-bank-cloze">Word Bank Cloze</h2>

<h3>{cloze.title}</h3>

{(experience === 'blog' || timerVariant === 'focus') && (
  <ReadingTimer
    timerId="cloze"
    label={cloze.title}
    wordCount={countWords(cloze.sentences)}
    variant={experience === 'blog' ? 'default' : timerVariant}
  />
)}

{cloze.wordBank && cloze.answers && (
  <ReadingSectionAnswers
    variant="cloze"
  wordBank={cloze.wordBank}
  answers={cloze.answers}
  answerRange={cloze.answerRange}
  />
)}

{cloze.sentences.map((sentence, index) => (
  <SentenceNote
    number={noteNumber('C', index)}
    sentence={sentence}
    closeReading={closeReadings?.[noteNumber('C', index)]}
    {inlineGlossary}
    {sharedGlossaryPhrases}
    {experience}
  />
))}

<h2 id="paragraph-matching">Paragraph Matching</h2>

<h3>{matching.title}</h3>

{(experience === 'blog' || timerVariant === 'focus') && (
  <ReadingTimer
    timerId="matching"
    label={matching.title}
    wordCount={countWords(matching.paragraphs.flatMap((paragraph) => paragraph.sentences))}
    variant={experience === 'blog' ? 'default' : timerVariant}
  />
)}

{matching.paragraphs.map((paragraph) => (
  <>
    <h3>Paragraph {paragraph.label}</h3>
    {paragraph.sentences.map((sentence, index) => (
      <SentenceNote
        number={noteNumber(`M-${paragraph.label}`, index)}
        {sentence}
        closeReading={closeReadings?.[noteNumber(`M-${paragraph.label}`, index)]}
        {inlineGlossary}
        {sharedGlossaryPhrases}
        {experience}
      />
    ))}
  </>
))}

{matching.questions && (
  <ReadingSectionAnswers variant="matching" questions={matching.questions} />
)}

<h2 id="reading-passages">Reading Passages</h2>

{passages.map((passage, passageIndex) => (
  <>
    <h3>{passage.title}</h3>
    {(experience === 'blog' || timerVariant === 'focus') && (
      <ReadingTimer
        timerId={`passage-${passageIndex + 1}`}
        label={passage.title}
        wordCount={countWords(passage.sentences)}
        variant={experience === 'blog' ? 'default' : timerVariant}
      />
    )}
    {passage.sentences.map((sentence, sentenceIndex) => (
      <SentenceNote
        number={noteNumber(`R${passageIndex + 1}-`, sentenceIndex)}
        {sentence}
        closeReading={closeReadings?.[noteNumber(`R${passageIndex + 1}-`, sentenceIndex)]}
        {inlineGlossary}
        {sharedGlossaryPhrases}
        {experience}
      />
    ))}
    {passage.questions && passage.questions.length > 0 && (
      <ReadingQuestions
        questions={passage.questions}
        {inlineGlossary}
        {sharedGlossaryPhrases}
        {experience}
      />
    )}
  </>
))}

<style>
  .reading-guide {
    display: grid;
    gap: 12px;
    margin: 0 0 46px;
    padding: 18px 20px 19px;
    border: 1px solid #d8e0db;
    border-radius: 14px;
    background: linear-gradient(135deg, #f3f8f4, #fbfcfa 68%);
    box-shadow: 0 10px 28px rgba(32, 52, 41, 0.045);
  }

  .reading-guide-heading {
    display: flex;
    gap: 11px;
    align-items: baseline;
  }

  .reading-guide-kicker {
    color: #3b8061;
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reading-guide-heading strong {
    color: #23332a;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.12rem;
    font-weight: 620;
  }

  .reading-guide p {
    max-width: none;
    margin: 0;
    color: #58665d;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .reading-guide-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    color: #64736a;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .reading-guide-items span {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }

  .guide-icon {
    display: inline-grid;
    width: 21px;
    height: 21px;
    place-items: center;
    border: 1px solid #b9cec0;
    border-radius: 50%;
    color: #317454;
    background: #e8f3eb;
    font-family: 'Inter Variable', Inter, sans-serif;
    font-size: 0.59rem;
    font-style: normal;
    font-weight: 760;
    line-height: 1;
  }

  .guide-word {
    width: 24px;
    border-color: transparent;
    border-radius: 4px;
    color: #356f58;
    background: transparent;
    text-decoration: underline;
    text-decoration-color: #78a88a;
    text-underline-offset: 3px;
  }

  .guide-clock { font-size: 0.85rem; }

  .reading-structure-mode {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 12px;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid #e1e9e3;
  }

  .reading-structure-mode-label {
    color: #40564a;
    font-size: 0.7rem;
    font-weight: 760;
    letter-spacing: 0.04em;
  }

  .reading-structure-mode-options {
    display: inline-flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid #cddbd1;
    border-radius: 9px;
    background: #f7faf7;
  }

  .reading-structure-mode-options button {
    padding: 5px 9px;
    border: 0;
    border-radius: 6px;
    color: #6a786f;
    background: transparent;
    font: inherit;
    font-size: 0.67rem;
    font-weight: 700;
    cursor: pointer;
  }

  .reading-structure-mode-options button[aria-pressed='true'] {
    color: #1f5f40;
    background: #e0f0e5;
    box-shadow: 0 1px 3px rgba(40, 72, 51, 0.08);
  }

  .reading-structure-mode-options button:focus-visible {
    outline: 2px solid rgba(49, 95, 155, 0.3);
    outline-offset: 1px;
  }

  .reading-structure-mode-hint {
    color: #748078;
    font-size: 0.68rem;
  }

  @media (max-width: 640px) {
    .reading-guide {
      margin-bottom: 36px;
      padding: 16px 15px 17px;
      border-radius: 12px;
    }

    .reading-guide-heading { display: grid; gap: 4px; }
    .reading-guide-items { gap: 8px 13px; }
    .reading-structure-mode { align-items: flex-start; }
    .reading-structure-mode-hint { width: 100%; }
  }
</style>
