---
import BaseHead from '../components/BaseHead.astro';
import ModuleHeader from '../components/ModuleHeader.astro';
import { SITE_TITLE } from '../consts';
import '../styles/site.css';
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description="Tend：两个持续生长的内容模块，记录 AI Agent 与项目实践。" /></head>
  <body class="site-page home-page">
    <ModuleHeader />
    <main class="home-frame">
      <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> TEND / 2026</p>
          <h1 id="home-title">Make room<br /><em>for the work.</em></h1>
          <p class="home-lede">一个轻量的个人工作台。把正在理解的系统，和已经做出来的东西，放在两个清晰的入口里。</p>
          <div class="home-hero-meta"><span>02 modules</span><span>∞ entries to come</span></div>
        </div>
        <div class="home-hero-art" aria-hidden="true">
          <div class="hero-art-orbit orbit-a"></div><div class="hero-art-orbit orbit-b"></div><div class="hero-art-core">T</div>
          <span class="hero-art-label label-a">observe</span><span class="hero-art-label label-b">build</span><span class="hero-art-label label-c">repeat</span>
        </div>
      </section>

      <section class="home-shelves" aria-labelledby="shelves-title">
        <div class="home-shelves-heading"><p class="eyebrow"><span class="eyebrow-line"></span> THE SHELVES</p><h2 id="shelves-title">选择一个方向。</h2></div>
        <div class="home-shelf-grid">
          <a class="home-shelf home-shelf-agent" href="/ai-agent/">
            <div class="shelf-top"><span>01 / SYSTEMS</span><span class="shelf-arrow">↗</span></div>
            <div class="shelf-index">A</div>
            <div class="shelf-copy"><p>AI Agent</p><h3>从模型到<br /><em>可工作的系统。</em></h3><span class="shelf-caption">notes · experiments · patterns</span></div>
            <div class="shelf-footer"><span>进入模块</span><strong>OPEN / 01</strong></div>
          </a>
          <a class="home-shelf home-shelf-projects" href="/projects/">
            <div class="shelf-top"><span>02 / SHOWCASE</span><span class="shelf-arrow">↗</span></div>
            <div class="shelf-index">P</div>
            <div class="shelf-copy"><p>Projects</p><h3>把想法变成<br /><em>可以运行的东西。</em></h3><span class="shelf-caption">builds · decisions · shipped work</span></div>
            <div class="shelf-footer"><span>进入模块</span><strong>OPEN / 02</strong></div>
          </a>
        </div>
      </section>
    </main>
    <footer class="site-footer"><span>Tend / personal workspace</span><span>AI Agent + Projects</span></footer>
  </body>
</html>
