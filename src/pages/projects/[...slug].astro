---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ModulePost from '../../layouts/ModulePost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'projects'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ModulePost title={entry.data.title} description={entry.data.description} pubDate={entry.data.pubDate} stack={entry.data.stack} module="projects" moduleLabel="Projects"><Content /></ModulePost>
