---
interface Props {
  active?: 'ai-agent' | 'projects';
}

const { active } = Astro.props;
---

<header class="module-header">
  <div class="module-header-inner">
    <a class="module-brand" href="/" aria-label="Tend 首页"><span class="module-brand-mark">+</span><span>Tend</span></a>
    <nav class="module-nav" aria-label="主导航">
      <a class:list={{ 'is-active': active === 'ai-agent' }} href="/ai-agent/">AI Agent</a>
      <a class:list={{ 'is-active': active === 'projects' }} href="/projects/">Projects</a>
    </nav>
  </div>
</header>
