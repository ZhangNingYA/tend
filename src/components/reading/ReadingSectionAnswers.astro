---
interface WordBankItem {
  key: string;
  word: string;
}

interface ClozeAnswer {
  number: number;
  key: string;
  word: string;
  evidence: string;
  analysis: string;
}

interface MatchingQuestion {
  number: number;
  prompt: string;
  answer: string;
  answerLabel?: string;
  evidence: string;
  analysis: string;
}

interface Props {
  variant: 'cloze' | 'matching';
  wordBank?: readonly WordBankItem[];
  answers?: readonly ClozeAnswer[];
  questions?: readonly MatchingQuestion[];
  answerRange?: string;
}

const {
  variant,
  wordBank = [],
  answers = [],
  questions = [],
  answerRange = '26–35',
} = Astro.props;
const matchingFirstQuestion = questions.at(0)?.number;
const matchingLastQuestion = questions.at(-1)?.number;
const matchingRange = matchingFirstQuestion === undefined
  ? '—'
  : matchingFirstQuestion === matchingLastQuestion
    ? String(matchingFirstQuestion)
    : `${matchingFirstQuestion}–${matchingLastQuestion}`;
---

{variant === 'cloze' ? (
  <section class="section-check section-check-cloze" aria-label="选词填空答案核对">
    <header>
      <span>Section A</span>
      <div>
        <h4>真题词库与答案</h4>
        <p>先根据词性和搭配自行还原空格，再展开核对。</p>
      </div>
    </header>
    <div class="word-bank" lang="en">
      {wordBank.map((item) => <span><b>{item.key}</b>{item.word}</span>)}
    </div>
    <details class="answer-sheet">
      <summary>查看 {answerRange} 答案与依据</summary>
      <ol>
        {answers.map((item) => (
          <li>
            <div class="answer-line"><b>{item.number}</b><strong>{item.key} · {item.word}</strong></div>
            <p lang="en">{item.evidence}</p>
            <small>{item.analysis}</small>
          </li>
        ))}
      </ol>
    </details>
  </section>
) : (
  <section class="section-check section-check-matching" aria-label="信息匹配题目与答案">
    <header>
      <span>Section B</span>
      <div>
        <h4>Questions {matchingRange}</h4>
        <p>先判断题干中的同义改写，再展开查看对应段落。</p>
      </div>
    </header>
    <ol class="matching-question-list">
      {questions.map((item) => (
        <li>
          <details>
            <summary><b>{item.number}</b><span lang="en">{item.prompt}</span></summary>
            <div class="matching-answer">
              <strong>{item.answerLabel ?? 'Paragraph'}{' '}{item.answer}</strong>
              <blockquote lang="en">{item.evidence}</blockquote>
              <p>{item.analysis}</p>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .section-check {
    margin: 24px 0 38px;
    border: 1px solid #dce3de;
    border-radius: 14px;
    background: #fbfcfa;
    overflow: hidden;
  }

  .section-check > header {
    display: flex;
    gap: 14px;
    align-items: start;
    padding: 17px 18px 15px;
    border-bottom: 1px solid #e3e8e4;
    background: linear-gradient(135deg, #f0f6f2, #fbfcfa);
  }

  .section-check > header > span {
    flex: 0 0 auto;
    padding: 4px 7px;
    border: 1px solid #b9d0c1;
    border-radius: 999px;
    color: #2f7453;
    font: 720 0.61rem/1 'Inter Variable', Inter, sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .section-check h4,
  .section-check p { margin: 0; }

  .section-check h4 {
    color: #223129;
    font: 620 1.08rem/1.25 'Source Serif 4 Variable', Georgia, serif;
  }

  .section-check header p {
    margin-top: 4px;
    color: #708078;
    font-size: 0.72rem;
  }

  .word-bank {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px 12px;
    padding: 17px 18px;
    border-bottom: 1px solid #e3e8e4;
  }

  .word-bank span {
    display: flex;
    gap: 7px;
    align-items: baseline;
    min-width: 0;
    color: #3d4942;
    font-size: 0.82rem;
  }

  .word-bank b,
  .answer-line b,
  .matching-question-list summary b {
    color: #39805f;
    font: 760 0.66rem/1 'Inter Variable', Inter, sans-serif;
  }

  .answer-sheet > summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    padding: 14px 18px;
    color: #315f49;
    font-size: 0.76rem;
    font-weight: 720;
    cursor: pointer;
    list-style: none;
  }

  .answer-sheet > summary::-webkit-details-marker,
  .matching-question-list summary::-webkit-details-marker { display: none; }

  .answer-sheet > summary::after,
  .matching-question-list summary::after {
    content: '+';
    color: #498064;
    font: 700 1rem/1 'Inter Variable', Inter, sans-serif;
  }

  .answer-sheet[open] > summary::after,
  .matching-question-list details[open] > summary::after { content: '−'; }

  .answer-sheet ol,
  .matching-question-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .answer-sheet ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid #e3e8e4;
  }

  .answer-sheet li {
    padding: 14px 17px 15px;
    border-bottom: 1px solid #edf0ed;
  }

  .answer-sheet li:nth-child(odd) { border-right: 1px solid #edf0ed; }

  .answer-line {
    display: flex;
    gap: 9px;
    align-items: center;
  }

  .answer-line strong { color: #26372e; font-size: 0.82rem; }

  .answer-sheet li > p {
    margin-top: 7px;
    color: #536159;
    font: 0.78rem/1.5 'Source Serif 4 Variable', Georgia, serif;
  }

  .answer-sheet small {
    display: block;
    margin-top: 5px;
    color: #78847d;
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .matching-question-list > li + li { border-top: 1px solid #e6eae7; }

  .matching-question-list summary {
    display: grid;
    grid-template-columns: 27px minmax(0, 1fr) 18px;
    gap: 8px;
    padding: 14px 17px;
    color: #344139;
    font: 0.86rem/1.5 'Source Serif 4 Variable', Georgia, serif;
    cursor: pointer;
    list-style: none;
  }

  .matching-answer {
    padding: 0 17px 16px 52px;
  }

  .matching-answer strong {
    color: #2f7654;
    font-size: 0.72rem;
  }

  .matching-answer blockquote {
    margin: 9px 0 7px;
    padding-left: 11px;
    border-left: 2px solid #bfd4c7;
    color: #4d5b53;
    font: 0.78rem/1.55 'Source Serif 4 Variable', Georgia, serif;
  }

  .matching-answer p {
    color: #76827b;
    font-size: 0.7rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .word-bank { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .answer-sheet ol { grid-template-columns: 1fr; }
    .answer-sheet li:nth-child(odd) { border-right: 0; }
    .matching-answer { padding-left: 17px; }
  }

  @media (max-width: 440px) {
    .word-bank { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
