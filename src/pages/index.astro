---
import BaseHead from '../components/BaseHead.astro';
import ModuleHeader from '../components/ModuleHeader.astro';
import { SITE_TITLE } from '../consts';
import '../styles/site.css';
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={SITE_TITLE} description="Tend：两个持续生长的内容模块，记录 AI Agent 与项目实践。" /></head>
  <body class="site-page home-page">
    <ModuleHeader />
    <main class="home-frame">
      <section class="home-intro" aria-labelledby="home-title">
        <div class="home-intro-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> TEND / WORKSPACE</p>
          <h1 id="home-title">个人工作台</h1>
        </div>
      </section>

      <section class="home-shelves" aria-labelledby="shelves-title">
        <div class="home-shelves-heading"><p id="shelves-title" class="eyebrow"><span class="eyebrow-line"></span> TWO MODULES</p></div>
        <div class="home-shelf-grid">
          <a class="home-shelf home-shelf-agent" href="/ai-agent/"><div class="shelf-top"><span>01</span><span class="shelf-arrow">↗</span></div><div class="shelf-copy"><p>AI Agent</p></div><div class="shelf-footer"><span>open</span></div></a>
          <a class="home-shelf home-shelf-projects" href="/projects/"><div class="shelf-top"><span>02</span><span class="shelf-arrow">↗</span></div><div class="shelf-copy"><p>Projects</p></div><div class="shelf-footer"><span>open</span></div></a>
        </div>
      </section>
    </main>
    <footer class="site-footer"><span>Tend / personal workspace</span><span>AI Agent + Projects</span></footer>
  </body>
</html>
