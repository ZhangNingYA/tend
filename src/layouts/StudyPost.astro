---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { ArrowLeft, Clock3 } from 'lucide-astro';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import { getStudyStageHeadings } from '../lib/studyStages';
import '../styles/study.css';

type Props = CollectionEntry<'study'>['data'] & {
  headings?: MarkdownHeading[];
  studyId?: string;
  seriesNavigation?: {
    previous?: { id: string; title: string };
    next?: { id: string; title: string };
    position: string;
  };
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  subject = '学习记录',
  estimatedMinutes,
  headings = [],
  studyId = Astro.url.pathname,
  seriesNavigation,
} = Astro.props;

const sections = headings.filter((heading) => heading.depth === 2);
const stageHeadings = getStudyStageHeadings(headings);
const stageIds = stageHeadings.map((heading) => heading.slug).join(',');
const displayDate = updatedDate ?? pubDate;
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const sectionTitle = (heading: MarkdownHeading) => heading.text.replace(/^\d+\s*\/\s*/, '');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="study-page study-article-page" data-study-page data-study-course={Astro.url.pathname} data-study-id={studyId} data-study-title={title} data-study-stage-ids={stageIds}>
    <BlogHeader active="study" />
    <div class="study-reading-progress" aria-hidden="true"><i data-study-progress-bar></i></div>

    <main class="study-article-shell">
      <div class="study-reader-topline">
        <a class="study-back" href="/study/"><ArrowLeft size={15} stroke-width={1.8} /> 学习记录</a>
        <span>STUDY</span>
      </div>

      <div class="study-reader-panel">
        <header class="study-article-header">
          <div class="study-article-header-inner">
            <div class="study-article-meta">
              <span>{subject}</span>
              <time datetime={displayDate.toISOString()}>{formatDate(displayDate)}</time>
              {estimatedMinutes && <span><Clock3 size={13} stroke-width={1.8} />约 {estimatedMinutes} 分钟</span>}
            </div>
            <h1>{title}</h1>
            <p>{description}</p>
            <div class="study-article-status-row">
              <div class="study-article-status" data-study-status><span class="study-status-dot"></span><span data-study-status-label>未完成</span></div>
              <span class="study-article-stage-summary" data-study-stage-summary>0 / {stageHeadings.length} 个阶段</span>
            </div>
          </div>
        </header>

      {sections.length > 0 && (
        <details class="study-mobile-toc">
          <summary>文章目录 <span>{sections.length} 节</span></summary>
          <nav aria-label="文章目录">
            <ol>
              {sections.map((heading) => <li><a href={`#${heading.slug}`}>{sectionTitle(heading)}</a></li>)}
            </ol>
          </nav>
        </details>
      )}

      <div class="study-article-layout">
        {sections.length > 0 && (
          <aside class="study-desktop-toc" aria-label="文章目录">
            <nav>
              <span class="study-toc-label">目录 <span>{sections.length}</span></span>
              <ol>
                {sections.map((heading) => (
                  <li><a href={`#${heading.slug}`} data-study-nav-link={heading.slug}>{sectionTitle(heading)}</a></li>
                ))}
              </ol>
            </nav>
          </aside>
        )}

        <article class="study-document" data-study-document data-study-title={title} data-study-description={description}>
          <slot />
        </article>
      </div>
      {seriesNavigation && (
        <nav class="study-series-navigation" aria-label="系列篇章导航">
          {seriesNavigation.previous
            ? <a href={`/study/${seriesNavigation.previous.id}/`}><span>← 上一篇</span><strong>{seriesNavigation.previous.title}</strong></a>
            : <span class="study-series-nav-empty"></span>}
          <span class="study-series-position">{seriesNavigation.position}</span>
          {seriesNavigation.next
            ? <a class="study-series-next" href={`/study/${seriesNavigation.next.id}/`}><span>下一篇 →</span><strong>{seriesNavigation.next.title}</strong></a>
            : <span class="study-series-nav-empty"></span>}
        </nav>
      )}
      </div>
    </main>

    <script>
      const progressBar = document.querySelector<HTMLElement>('[data-study-progress-bar]');
      const updateProgress = () => {
        if (!progressBar) return;
        const documentElement = document.documentElement;
        const scrollableHeight = documentElement.scrollHeight - documentElement.clientHeight;
        const progress = scrollableHeight > 0 ? documentElement.scrollTop / scrollableHeight : 0;
        progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-study-nav-link]'));
      const headings = Array.from(document.querySelectorAll<HTMLElement>('.study-document h2'));
      if (links.length && headings.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const id = entry.target.id;
            links.forEach((link) => {
              if (link.dataset.studyNavLink === id) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }
        }, { rootMargin: '-12% 0px -72% 0px' });
        headings.forEach((heading) => observer.observe(heading));
      }

      const progressKey = 'tend-study-progress';
      const page = document.querySelector<HTMLElement>('[data-study-page]');
      const documentNode = document.querySelector<HTMLElement>('[data-study-document]');
      const status = document.querySelector<HTMLElement>('[data-study-status]');
      const statusLabel = document.querySelector<HTMLElement>('[data-study-status-label]');
      const stageSummary = document.querySelector<HTMLElement>('[data-study-stage-summary]');
      if (page && documentNode && status && statusLabel && stageSummary) {
        const id = page.dataset.studyId ?? page.dataset.studyCourse ?? '';
        const stageIds = (page.dataset.studyStageIds ?? '').split(',').filter(Boolean);
        const stages = stageIds.map((stageId) => document.getElementById(stageId)).filter((stage): stage is HTMLElement => Boolean(stage));
        let progress: Record<string, Record<string, boolean>> = {};
        let saved: Record<string, boolean | Record<string, boolean>> = {};
        try {
          saved = JSON.parse(localStorage.getItem(progressKey) ?? '{}') as Record<string, boolean | Record<string, boolean>>;
          for (const [studyId, value] of Object.entries(saved)) {
            if (typeof value !== 'boolean') progress[studyId] = value;
          }
        } catch { /* private browsing */ }
        const save = () => {
          try { localStorage.setItem(progressKey, JSON.stringify({ ...saved, ...progress })); } catch { /* private browsing */ }
        };
        if (saved[id] === true) {
          progress[id] = Object.fromEntries(stages.map((stage) => [stage.id, true]));
          save();
          saved[id] = progress[id];
        }
        const syncStatus = () => {
          const completed = stages.filter((stage) => progress[id]?.[stage.id]).length;
          const complete = stages.length > 0 && completed === stages.length;
          statusLabel.textContent = complete ? '已完成' : '未完成';
          status.classList.toggle('is-completed', complete);
          stageSummary.textContent = `${completed} / ${stages.length} 个阶段`;
        };
        stages.forEach((stage, index) => {
          const stageId = stage.id || `stage-${index + 1}`;
          if (!stage.id) stage.id = stageId;
          stage.dataset.studyStage = stageId;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'study-stage-toggle';
          button.dataset.studyStageToggle = stageId;
          button.setAttribute('aria-label', `标记阶段“${stage.textContent?.trim() ?? ''}”完成`);
          button.innerHTML = '<span class="study-toggle-icon" aria-hidden="true">✓</span><span class="study-stage-label">完成阶段</span>';
          stage.append(button);
          const syncStage = () => {
            const done = Boolean(progress[id]?.[stageId]);
            button.setAttribute('aria-pressed', String(done));
            button.querySelector<HTMLElement>('.study-stage-label')!.textContent = done ? '已完成' : '完成阶段';
            stage.classList.toggle('is-study-stage-completed', done);
          };
          button.addEventListener('click', () => {
            progress[id] ??= {};
            progress[id][stageId] = !progress[id][stageId];
            save();
            syncStage();
            syncStatus();
          });
          syncStage();
        });
        syncStatus();
      }
    </script>
  </body>
</html>
