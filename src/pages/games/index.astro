---
import { getCollection } from 'astro:content';
import { ArrowUpRight, BookOpenText, FileQuestion } from 'lucide-astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import BaseHead from '../../components/BaseHead.astro';
import '../../styles/games-library.css';

const hubs = (await getCollection('games'))
  .filter((post) => post.data.pageLayout === 'library')
  .sort((a) => (a.data.libraryKind === 'exam-papers' ? -1 : 1));

const copy = {
  'exam-papers': {
    no: '01',
    eyebrow: 'CET-4 READING',
    action: '进入真题目录',
    className: 'index-category--exam',
  },
  'english-rabbit': {
    no: '02',
    eyebrow: 'GRAMMAR NOTES',
    action: '进入课程笔记',
    className: 'index-category--rabbit',
  },
} as const;
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title="学习资料库 · Tend" description="真题精读与英语兔语法课程笔记。" /></head>
  <body class="games-library-index">
    <div class="library-ambient" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="library-topbar">
      <a class="library-brand" href="/games/">
        <span class="library-brand-mark">T</span>
        <span><strong>Tend Study</strong><small>Learning archive</small></span>
      </a>
      <nav aria-label="页面导航"><a href="/">返回首页</a></nav>
    </header>

    <main class="library-index-shell">
      <section class="index-hero">
        <div>
          <p class="index-kicker">LEARNING LIBRARY · 02 COLLECTIONS</p>
          <h1>把资料放好，<br />把知识<em>连起来</em></h1>
          <p class="index-description">一个入口练真题，一个入口搭语法体系。内容按类型分开，学习路径保持连贯。</p>
        </div>
        <aside class="index-hero-side">
          <p>阅读练习强调做题与精读；语法笔记强调框架、术语和例句验证。两类内容互不混排。</p>
          <span>CHOOSE A COLLECTION ↓</span>
        </aside>
      </section>

      <section class="index-grid" aria-label="资料分类">
        {hubs.map((hub) => {
          const kind = hub.data.libraryKind ?? 'exam-papers';
          const item = copy[kind];
          return (
            <a class={`index-category ${item.className}`} href={`/games/${hub.id}/`}>
              <div class="index-category-art" aria-hidden="true"></div>
              <div class="index-category-head">
                <span class="index-category-icon">
                  {kind === 'exam-papers' ? <FileQuestion size={24} /> : <BookOpenText size={24} />}
                </span>
                <span class="index-category-no">{item.no}</span>
              </div>
              <div class="index-category-copy">
                <span>{item.eyebrow}</span>
                <h2>{hub.data.title}</h2>
                <p>{hub.data.description}</p>
              </div>
              <div class="index-category-foot"><span>{item.action}</span><ArrowUpRight size={19} /></div>
            </a>
          );
        })}
      </section>
    </main>

    <footer class="library-footer"><span>Tend Study Archive</span><span>Read · Understand · Rebuild</span></footer>
  </body>
</html>
