---
import { getCollection } from 'astro:content';
import {
  ArrowLeft,
  ArrowUpRight,
  CheckCircle2,
  FileQuestion,
  Languages,
  Layers3,
  Timer,
} from 'lucide-astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import BaseHead from '../components/BaseHead.astro';
import '../styles/games-library.css';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const allGames = await getCollection('games');
const entries = allGames
  .filter((post) => post.data.pageLayout === 'reading')
  .sort((a, b) => b.id.localeCompare(a.id));
const answerEntries = entries.filter((post) => post.data.answerCoverage && post.data.answerCoverage !== 'none');

const getPaperMeta = (id: string) => {
  const match = id.match(/^(\d{4})-(\d{2})-cet4-reading-(\d+)$/);
  if (!match) return { session: 'CET-4', set: 'Reading' };
  return {
    session: `${match[1]} 年 ${Number(match[2])} 月`,
    set: `第 ${match[3]} 套`,
  };
};

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {title} {description} />
  </head>
  <body class="games-hub-page">
    <div class="library-ambient" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="library-topbar">
      <a class="library-brand" href="/games/">
        <span class="library-brand-mark">T</span>
        <span><strong>Tend Study</strong><small>Learning archive</small></span>
      </a>
      <nav aria-label="页面导航">
        <a href="/games/"><ArrowLeft size={16} aria-hidden="true" />资料库</a>
        <a href="/">首页</a>
      </nav>
    </header>

    <main class="hub-shell">
      <section class="hub-hero">
        <div class="hub-copy">
          <p class="hub-kicker">EXAM READING LAB</p>
          <h1>真题，拿来<em>读透</em></h1>
          <p class="hub-description">{description}</p>
          <div class="hub-actions">
            <a class="button button-primary" href="#library-entries">开始学习 <ArrowUpRight size={17} aria-hidden="true" /></a>
          </div>
        </div>

        <div class="hub-visual" aria-hidden="true">
          <span class="visual-orbit orbit-a"></span><span class="visual-orbit orbit-b"></span>
          <div class="exam-sheet sheet-back"></div>
          <div class="exam-sheet sheet-front">
            <span>READING</span><strong>CET-4</strong>
            <i></i><i></i><i></i><i></i>
            <b>ABCD</b>
          </div>
        </div>
      </section>

      <section class="hub-stats" aria-label="资料概况">
        <div><strong>{String(entries.length).padStart(2, '0')}</strong><span>套阅读真题</span></div>
        <div><strong>03</strong><span>种阅读题型</span></div>
        <div><strong>{answerEntries.length}/{entries.length}</strong><span>套含答案核对</span></div>
      </section>

      <section class="hub-intro-card">
        <div class="intro-icon"><FileQuestion size={24} /></div>
        <div>
          <p>HOW TO USE</p>
          <h2>先通读，再按页面范围精读</h2>
          <span>每套都会标明当前整理范围，并提供计时、逐句翻译、词义和句子结构；答案与结构双模式按页面实际标注为准。</span>
        </div>
      </section>

      <section class="hub-entries" id="library-entries">
        <header class="hub-section-heading">
          <div><p>COLLECTION</p><h2>阅读真题</h2></div>
          <span>{entries.length} entries · 持续整理</span>
        </header>

        <div class="entry-grid">
          {entries.map((post, index) => {
            const paper = getPaperMeta(post.id);
            const number = String(index + 1).padStart(2, '0');
            return (
              <a class="entry-card" href={`/games/${post.id}/`}>
                <div class="entry-card-top">
                  <span class="entry-number">{number}</span>
                  <span class="entry-status"><CheckCircle2 size={14} aria-hidden="true" /> 已整理</span>
                </div>
                <p class="entry-overline">{paper.session} · {paper.set}</p>
                <h3>{paper.session} 四级阅读 {paper.set}</h3>
                <p class="entry-summary">{post.data.description}</p>
                <div class="entry-tags">
                  <span><Timer size={14} />计时</span>
                  <span><Languages size={14} />逐句精读</span>
                  {post.data.answerCoverage === 'full' && <span><CheckCircle2 size={14} />答案核对</span>}
                  {post.data.answerCoverage === 'passage-only' && <span><CheckCircle2 size={14} />仔细阅读答案</span>}
                  {post.data.hasStructureModes && <span><Layers3 size={14} />结构双模式</span>}
                </div>
                <div class="entry-open"><span>进入练习</span><ArrowUpRight size={18} aria-hidden="true" /></div>
              </a>
            );
          })}
        </div>
      </section>
    </main>

    <footer class="library-footer"><span>Tend Study Archive</span><span>Built for deliberate practice · {new Date().getFullYear()}</span></footer>
  </body>
</html>
