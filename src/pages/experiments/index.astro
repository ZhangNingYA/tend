---
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/studio.css';

const experiments = [
  { number: '01', state: '下一步', title: 'Tool call trace', body: '把 Agent 的观察、决策、工具调用和结果放在同一条时间线上。', color: 'cyan' },
  { number: '02', state: '设计中', title: 'Retrieval playground', body: '比较切分、召回、重排和引用质量，找到 RAG 失败的具体位置。', color: 'violet' },
  { number: '03', state: '排队中', title: 'Memory sandbox', body: '观察短期上下文、长期记忆和遗忘策略怎样改变 Agent 的行为。', color: 'orange' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={`实验 · ${SITE_TITLE}`} description="AI Agent 的交互实验和系统验证。" /></head>
  <body class="studio-page">
    <BlogHeader active="experiments" />
    <main class="studio-shell studio-main">
      <header class="studio-index-hero"><div><div class="studio-kicker"><span class="studio-kicker-dot"></span> 交互式验证</div><h1>实验。</h1><p>先把一个问题变成可以操作的东西，再决定它是否值得做成系统。</p></div><div class="studio-index-count"><strong>03</strong> 个待做实验</div></header>
      <section class="studio-section"><div class="studio-portal-grid">{experiments.map((experiment) => <article class="studio-portal"><div class="studio-portal-top"><span class="studio-portal-index">{experiment.number} / {experiment.state}</span><span class="studio-portal-arrow">↗</span></div><div><h3>{experiment.title}</h3><p>{experiment.body}</p></div></article>)}</div></section>
    </main>
    <footer class="studio-shell studio-footer"><span>实验 / Tend</span><span><a href="/field-notes/">笔记</a> · <a href="/builds/">项目</a></span></footer>
  </body>
</html>
